<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tasksFragment">

    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.studyando.ui.tasks.TasksFragment"
        android:label="Tareas">

        <action
            android:id="@+id/action_tasksFragment_to_addEditTaskFragment"
            app:destination="@id/addEditTaskFragment" />

    </fragment>

    <fragment
        android:id="@+id/pomodoroFragment"
        android:name="com.studyando.ui.pomodoro.PomodoroFragment"
        android:label="Pomodoro" />

    <fragment
        android:id="@+id/completedFragment"
        android:name="com.studyando.ui.completed.CompletedFragment"
        android:label="Realizadas" />

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.studyando.ui.schedule.ScheduleFragment"
        android:label="Horario" />

    <dialog
        android:id="@+id/addEditTaskFragment"
        android:name="com.studyando.ui.tasks.AddEditTaskFragment"
        android:label="Añadir Tarea" >
        <argument
            android:name="taskId"
            app:argType="long"
            android:defaultValue="-1L" />
    </dialog>

</navigation>
